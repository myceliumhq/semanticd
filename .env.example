# One semanticd process = one adapter/source -- run it as a sidecar next
# to the service it indexes. The adapter itself is wired in code (e.g.
# @myceliumhq/tri's `tri-semanticd` binary), not selected via env var.

SEMANTICD_PORT=4499
SEMANTICD_INDEX_PATH=./semanticd.db
SEMANTICD_SYNC_INTERVAL_MS=900000

# Zero-API-key local embedding provider (small CPU ONNX model):
EMBEDDING_PROVIDER=local

# Or any OpenAI-compatible /v1/embeddings endpoint:
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=your-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# The adapter reads its own connection config -- e.g. tri-semanticd needs:
# TRILIUM_URL=https://trilium.example.com
# TRILIUM_TOKEN=your-etapi-token
